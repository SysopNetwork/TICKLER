/* TICKLER.RC - Version resource for TICKLER.DLL */

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x2L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Sysop Network"
            VALUE "FileDescription",  "TICKLER - The Major BBS V10 Watchdog Marker Module"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "TICKLER"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Sysop Network"
            VALUE "OriginalFilename", "TICKLER.DLL"
            VALUE "ProductName",      "TICKLER for The Major BBS V10"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
